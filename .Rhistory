valid_pollster_party <- df_model |>
count(
pollster_key,
party_key,
name = "n"
) |>
filter(
n >= MIN_POLLS_POLLSTER_PARTY
)
df_model <- df_model |>
semi_join(
valid_pollster_party,
by = c(
"pollster_key",
"party_key"
)
) |>
droplevels()
# ------------------------------------------------------------
# OPCIONAL: PESOS POR TAMAÑO MUESTRAL
# ------------------------------------------------------------
#
# Si existe sample_size, usamos una ponderación moderada.
#
# sqrt(n) evita que una encuesta enorme domine demasiado.
# Es una heurística, no una corrección exacta de varianza.
if ("sample_size" %in% names(df_model)) {
df_model <- df_model |>
mutate(
model_weight = case_when(
is.na(sample_size) ~ 1,
sample_size <= 0 ~ 1,
TRUE ~ sqrt(sample_size)
)
)
} else {
df_model <- df_model |>
mutate(
model_weight = 1
)
}
# ------------------------------------------------------------
# MODELO GAM
# ------------------------------------------------------------
#
# party_key:
# nivel medio distinto por partido
#
# s(date_num, by = party_key):
# tendencia temporal distinta por partido
#
# s(pollster_key, party_key, bs = "re"):
# house effect específico de encuestadora × partido
mod_house <- gam(
vote_share ~
party_key +
s(
date_num,
by = party_key,
k = 30
) +
s(
pollster_key,
party_key,
bs = "re"
),
data = df_model,
weights = model_weight,
method = "REML"
)
# ------------------------------------------------------------
# DIAGNÓSTICOS
# ------------------------------------------------------------
summary(mod_house)
gam.check(mod_house)
# ------------------------------------------------------------
# EXTRAER EFECTOS ALEATORIOS
# ------------------------------------------------------------
#
# gratia simplifica mucho la extracción de smooths.
# Si no está instalado:
#
# install.packages("gratia")
library(gratia)
house_effect_raw <- smooth_estimates(
mod_house,
select = "s(pollster_key,party_key)"
)
# ------------------------------------------------------------
# INSPECCIONAR ESTRUCTURA
# ------------------------------------------------------------
names(house_effect_raw)
house_effect_raw
# ------------------------------------------------------------
# PREPARAR TABLA DE HOUSE EFFECTS
# ------------------------------------------------------------
#
# gratia puede cambiar ligeramente nombres de columnas
# según versión.
#
# La lógica esperada es:
# .estimate
# .se
# pollster_key
# party_key
house_effects <- house_effect_raw |>
transmute(
pollster_key = as.character(pollster_key),
party_key = as.character(party_key),
house_effect = .estimate,
se = .se,
ic_low = house_effect - 1.96 * se,
ic_high = house_effect + 1.96 * se
) |>
left_join(
df_model |>
count(
pollster_key,
party_key,
name = "n"
) |>
mutate(
pollster_key = as.character(pollster_key),
party_key = as.character(party_key)
),
by = c(
"pollster_key",
"party_key"
)
) |>
mutate(
house_effect_status = case_when(
ic_low > 0 ~ "positivo",
ic_high < 0 ~ "negativo",
TRUE ~ "no claro"
)
) |>
arrange(
party_key,
desc(abs(house_effect))
)
# ------------------------------------------------------------
# RESULTADOS PRINCIPALES
# ------------------------------------------------------------
house_effects
# ------------------------------------------------------------
# TOP HOUSE EFFECTS PSOE
# ------------------------------------------------------------
house_effects |>
filter(
party_key == "psoe",
house_effect_status != "no claro"
) |>
slice_max(
abs(house_effect),
n = 7
)
# ------------------------------------------------------------
# TOP HOUSE EFFECTS PP
# ------------------------------------------------------------
house_effects |>
filter(
party_key == "pp",
house_effect_status != "no claro"
) |>
slice_max(
abs(house_effect),
n = 7
)
# ------------------------------------------------------------
# TOP GLOBAL
# ------------------------------------------------------------
house_effects |>
filter(
house_effect_status != "no claro"
) |>
slice_max(
abs(house_effect),
n = 10
)
# ------------------------------------------------------------
# GRÁFICO DE HOUSE EFFECTS
# ------------------------------------------------------------
library(tidytext)
house_effects |>
filter(
n >= MIN_POLLS_POLLSTER_PARTY,
house_effect_status != "no claro"
) %>%
mutate(
party_key = as.factor(party_key),
pollster_key = reorder_within(pollster_key, house_effect, party_key)) |>
ggplot(
aes(
x = house_effect,
y = reorder(
pollster_key,
house_effect
)
)
) +
geom_vline(
xintercept = 0,
alpha = 0.4
) +
geom_errorbar(
aes(
xmin = ic_low,
xmax = ic_high
),
width = 0
) +
geom_point() +
facet_wrap(
~ party_key,
scales = "free_y"
) +
theme_minimal() +
labs(
title = "House effects por encuestadora y partido",
subtitle = "Estimados mediante GAM con efecto aleatorio pollster × party",
x = "Desviación estimada en puntos porcentuales",
y = NULL
) +
scale_y_reordered()
library(dplyr)
library(tidyr)
library(ggplot2)
library(mgcv)
library(spainpolls)
# ------------------------------------------------------------
# CONFIGURACIÓN
# ------------------------------------------------------------
ELECTION_KEY <- c("congreso_espana_2027", "congreso_espana_2023")
PARTIES <- c(
"psoe",
"pp",
"vox",
"sumar"
)
MIN_POLLS_POLLSTER_PARTY <- 5
# ------------------------------------------------------------
# DESCARGAR DATOS
# ------------------------------------------------------------
ts <- get_timeseries(
election_key = ELECTION_KEY,
date_field = "fieldwork_end",
party_key = PARTIES,
collect_all = TRUE,
include_manual_review = FALSE
)
sample_sizes <-
ts |>
select(poll_id, sample_size) |>
distinct() |>
mutate(sample_size = ifelse(is.na(sample_size), mean(sample_size, na.rm = T), sample_size))
ts <-
ts |>
select(-sample_size) |>
left_join(sample_sizes, by = join_by(poll_id))
# ------------------------------------------------------------
# PREPARAR DATOS
# ------------------------------------------------------------
df_model <- ts |>
mutate(
date = as.Date(date),
date_num = as.numeric(date),
vote_share = as.numeric(vote_share),
pollster_key = factor(pollster_key),
party_key = factor(party_key)
) |>
filter(
!is.na(vote_share),
!is.na(date_num),
!is.na(pollster_key),
!is.na(party_key)
)
# ------------------------------------------------------------
# FILTRAR ENCUESTADORAS CON SUFICIENTE N
# ------------------------------------------------------------
#
# Esto evita estimar efectos con casas que solo tienen
# una o dos observaciones para un partido.
#
# El efecto aleatorio puede manejar grupos pequeños,
# pero para interpretar house effects conviene tener
# un mínimo descriptivo.
valid_pollster_party <- df_model |>
count(
pollster_key,
party_key,
name = "n"
) |>
filter(
n >= MIN_POLLS_POLLSTER_PARTY
)
df_model <- df_model |>
semi_join(
valid_pollster_party,
by = c(
"pollster_key",
"party_key"
)
) |>
droplevels()
# ------------------------------------------------------------
# OPCIONAL: PESOS POR TAMAÑO MUESTRAL
# ------------------------------------------------------------
#
# Si existe sample_size, usamos una ponderación moderada.
#
# sqrt(n) evita que una encuesta enorme domine demasiado.
# Es una heurística, no una corrección exacta de varianza.
if ("sample_size" %in% names(df_model)) {
df_model <- df_model |>
mutate(
model_weight = case_when(
is.na(sample_size) ~ 1,
sample_size <= 0 ~ 1,
TRUE ~ sqrt(sample_size)
)
)
} else {
df_model <- df_model |>
mutate(
model_weight = 1
)
}
# ------------------------------------------------------------
# MODELO GAM
# ------------------------------------------------------------
#
# party_key:
# nivel medio distinto por partido
#
# s(date_num, by = party_key):
# tendencia temporal distinta por partido
#
# s(pollster_key, party_key, bs = "re"):
# house effect específico de encuestadora × partido
mod_house <- gam(
vote_share ~
party_key +
s(
date_num,
by = party_key,
k = 30
) +
s(
pollster_key,
party_key,
bs = "re"
),
data = df_model,
weights = model_weight,
method = "REML"
)
# ------------------------------------------------------------
# DIAGNÓSTICOS
# ------------------------------------------------------------
summary(mod_house)
gam.check(mod_house)
# ------------------------------------------------------------
# EXTRAER EFECTOS ALEATORIOS
# ------------------------------------------------------------
#
# gratia simplifica mucho la extracción de smooths.
# Si no está instalado:
#
# install.packages("gratia")
library(gratia)
house_effect_raw <- smooth_estimates(
mod_house,
select = "s(pollster_key,party_key)"
)
# ------------------------------------------------------------
# INSPECCIONAR ESTRUCTURA
# ------------------------------------------------------------
names(house_effect_raw)
house_effect_raw
# ------------------------------------------------------------
# PREPARAR TABLA DE HOUSE EFFECTS
# ------------------------------------------------------------
#
# gratia puede cambiar ligeramente nombres de columnas
# según versión.
#
# La lógica esperada es:
# .estimate
# .se
# pollster_key
# party_key
house_effects <- house_effect_raw |>
transmute(
pollster_key = as.character(pollster_key),
party_key = as.character(party_key),
house_effect = .estimate,
se = .se,
ic_low = house_effect - 1.96 * se,
ic_high = house_effect + 1.96 * se
) |>
left_join(
df_model |>
count(
pollster_key,
party_key,
name = "n"
) |>
mutate(
pollster_key = as.character(pollster_key),
party_key = as.character(party_key)
),
by = c(
"pollster_key",
"party_key"
)
) |>
mutate(
house_effect_status = case_when(
ic_low > 0 ~ "positivo",
ic_high < 0 ~ "negativo",
TRUE ~ "no claro"
)
) |>
arrange(
party_key,
desc(abs(house_effect))
)
# ------------------------------------------------------------
# RESULTADOS PRINCIPALES
# ------------------------------------------------------------
house_effects
# ------------------------------------------------------------
# TOP HOUSE EFFECTS PSOE
# ------------------------------------------------------------
house_effects |>
filter(
party_key == "psoe",
house_effect_status != "no claro"
) |>
slice_max(
abs(house_effect),
n = 7
)
# ------------------------------------------------------------
# TOP HOUSE EFFECTS PP
# ------------------------------------------------------------
house_effects |>
filter(
party_key == "pp",
house_effect_status != "no claro"
) |>
slice_max(
abs(house_effect),
n = 7
)
# ------------------------------------------------------------
# TOP GLOBAL
# ------------------------------------------------------------
house_effects |>
filter(
house_effect_status != "no claro"
) |>
slice_max(
abs(house_effect),
n = 10
)
# ------------------------------------------------------------
# GRÁFICO DE HOUSE EFFECTS
# ------------------------------------------------------------
library(tidytext)
house_effects |>
filter(
n >= MIN_POLLS_POLLSTER_PARTY,
house_effect_status != "no claro"
) %>%
mutate(
party_key = as.factor(party_key),
pollster_key = reorder_within(pollster_key, house_effect, party_key)) |>
ggplot(
aes(
x = house_effect,
y = reorder(
pollster_key,
house_effect
)
)
) +
geom_vline(
xintercept = 0,
alpha = 0.4
) +
geom_errorbar(
aes(
xmin = ic_low,
xmax = ic_high
),
width = 0
) +
geom_point() +
facet_wrap(
~ party_key,
scales = "free_y"
) +
theme_minimal() +
labs(
title = "House effects por encuestadora y partido",
subtitle = "Estimados mediante GAM con efecto aleatorio pollster × party",
x = "Desviación estimada en puntos porcentuales",
y = NULL
) +
scale_y_reordered()
